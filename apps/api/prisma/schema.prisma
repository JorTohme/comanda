generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id         String   @id @default(uuid())
  nombre     String
  orgId      String
  sucursalId String
  organizacion Organizacion @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sucursal     Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  platos     Plato[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId, sucursalId])
}

model Plato {
  id          String    @id @default(uuid())
  nombre      String
  precio      Int
  disponible  Boolean   @default(true)
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  orgId       String
  sucursalId  String
  organizacion Organizacion @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sucursal     Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  itemsPedido ItemPedido[]

  @@index([orgId, sucursalId])
}

enum EstadoMesa {
  libre
  ocupada
  pedido_en_curso
}

model Mesa {
  id         String     @id @default(uuid())
  nombre     String
  capacidad  Int
  estado     EstadoMesa @default(libre)
  posX       Float?
  posY       Float?
  rotacion   Float?     @default(0)
  forma      String?    @default("rect")
  ancho      Float?     @default(70)
  alto       Float?     @default(70)
  orgId      String
  sucursalId String
  organizacion Organizacion @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sucursal     Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  pedidos    Pedido[]

  @@index([orgId, sucursalId])
}

enum TipoServicio {
  mesa
  barra
}

enum EstadoPedido {
  abierto
  enviado_a_cocina
  en_preparacion
  listo
  entregado
  cobrado
  cerrado
}

model Pedido {
  id              String       @id @default(uuid())
  tipoServicio    TipoServicio
  mesaId          String?
  mesa            Mesa?        @relation(fields: [mesaId], references: [id], onDelete: Restrict)
  estado          EstadoPedido @default(abierto)
  items           ItemPedido[]
  clientRequestId String?      @unique
  orgId           String
  sucursalId      String
  organizacion Organizacion @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sucursal     Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  turnoCajaId  String?
  turnoCaja    TurnoCaja?   @relation(fields: [turnoCajaId], references: [id], onDelete: Restrict)
  pago         Pago?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId, sucursalId])
}

enum EstadoPago {
  pendiente
  aprobado
  rechazado
}

model Pago {
  id             String     @id @default(uuid())
  pedidoId       String     @unique
  pedido         Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  mpPaymentId    String?    @unique
  mpPreferenceId String
  mpInitPoint    String
  estado         EstadoPago @default(pendiente)
  monto          Int
  orgId          String
  sucursalId     String
  organizacion   Organizacion @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sucursal       Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([orgId, sucursalId])
}

enum EstadoTurnoCaja {
  abierto
  cerrado
}

enum TipoMovimientoCaja {
  ingreso
  egreso
}

model TurnoCaja {
  id             String           @id @default(uuid())
  orgId          String
  sucursalId     String
  organizacion   Organizacion     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sucursal       Sucursal         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  estado         EstadoTurnoCaja  @default(abierto)
  montoInicial   Int
  abiertoPorId   String
  abiertoPor     Usuario          @relation("TurnoCajaAbiertoPor", fields: [abiertoPorId], references: [id], onDelete: Restrict)
  abiertoEn      DateTime         @default(now())
  cerradoPorId   String?
  cerradoPor     Usuario?         @relation("TurnoCajaCerradoPor", fields: [cerradoPorId], references: [id], onDelete: Restrict)
  cerradoEn      DateTime?
  montoDeclarado Int?
  totalCalculado Int?
  diferencia     Int?
  movimientos    MovimientoCaja[]
  pedidos        Pedido[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([orgId, sucursalId])
  @@index([orgId, sucursalId, estado])
}

model MovimientoCaja {
  id          String             @id @default(uuid())
  turnoCajaId String
  turnoCaja   TurnoCaja          @relation(fields: [turnoCajaId], references: [id], onDelete: Cascade)
  tipo        TipoMovimientoCaja
  monto       Int
  descripcion String
  createdAt   DateTime           @default(now())

  @@index([turnoCajaId])
}

enum RolUsuario {
  admin
  caja
  mozo
  cocina
}

model Organizacion {
  id         String      @id @default(uuid())
  nombre     String
  sucursales Sucursal[]
  usuarios   Usuario[]
  categorias Categoria[]
  platos     Plato[]
  mesas      Mesa[]
  pedidos    Pedido[]
  turnosCaja TurnoCaja[]
  pagos      Pago[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Sucursal {
  id             String       @id @default(uuid())
  nombre         String
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuarios       Usuario[]
  categorias     Categoria[]
  platos         Plato[]
  mesas          Mesa[]
  pedidos        Pedido[]
  turnosCaja     TurnoCaja[]
  pagos          Pago[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizacionId, nombre])
}

model Usuario {
  id             String       @id @default(uuid())
  nombre         String
  email          String       @unique
  passwordHash   String
  rol            RolUsuario  @default(admin)
  organizacionId String
  sucursalId     String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sucursal       Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  turnosAbiertos TurnoCaja[]  @relation("TurnoCajaAbiertoPor")
  turnosCerrados TurnoCaja[]  @relation("TurnoCajaCerradoPor")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizacionId, sucursalId])
}

model ItemPedido {
  id             String @id @default(uuid())
  pedidoId       String
  pedido         Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  platoId        String
  plato          Plato  @relation(fields: [platoId], references: [id], onDelete: Restrict)
  nombre         String
  precioUnitario Int
  cantidad       Int
}
