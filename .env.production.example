# Copy to .env.production (gitignored) and fill in. Used by docker-compose.prod.yml.
# Pass it to compose so ${...} interpolation works: --env-file .env.production

# --- Reverse proxy (Caddy) ---
# Public hostname of the API; its DNS A/AAAA record must point at this VM. Use "localhost" for a local smoke test.
API_DOMAIN=api.example.com

# --- Postgres ---
# Hex only (keeps DATABASE_URL valid without URL-encoding): openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Must embed the same password as POSTGRES_PASSWORD. Host "postgres" is the compose service name.
DATABASE_URL=postgresql://comanda:change-me@postgres:5432/comanda?schema=public

# --- API (required in production) ---
NODE_ENV=production
PORT=3001
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated browser origins allowed for HTTP and WebSocket (the Cloudflare Pages URLs, no trailing slash).
CORS_ORIGINS=https://comanda-web.pages.dev,https://comanda-operativa.pages.dev
# Web console base URL; used in invitation links.
WEB_APP_URL=https://comanda-web.pages.dev

# --- Backups ---
# Days of nightly dumps kept in the "backups" volume.
BACKUP_RETENTION_DAYS=14

# --- Optional: Redis (only needed to run more than one API instance) ---
# Unset = in-memory realtime and rate limiting (single instance).
# REDIS_URL=redis://redis:6379

# --- Optional: Mercado Pago (unset MERCADOPAGO_ACCESS_TOKEN = payment endpoints return 503) ---
# If the access token is set, the other three become required in production.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_MERCHANT_ID=
# Public API base URL used for the Mercado Pago webhook/return URLs.
# PUBLIC_BASE_URL=https://api.example.com
